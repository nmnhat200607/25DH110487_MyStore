@model IEnumerable<_25DH110487_MyStore.Models.Product>

@{
    ViewBag.Title = "Index";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}
<head>
    <style>
        img{
            height:150px;
            max-width: 150px;

        }
    </style>
</head>

<h2 class="bg-success">DANH SÁCH SẢN PHẨM</h2>

<p>
    @Html.ActionLink("Thêm mới", "Create", null, new { @class = "btn btn-primary btn-sm " })
</p>
<table class="table">
    <tr>
        <th class="bg-success col-md-1">
            Tên sản phầm
        </th>
        
        <th class="bg-success col-md-1">
            Đơn giá
        </th>
        <th class="bg-success col-md-1">
            Hình ảnh
        </th>
        <th class="bg-success col-md-1">
            Danh mục
        </th>
        <th class="bg-success "></th>
    </tr>

@foreach (var item in Model) {
    <tr>
        <td>
            @Html.DisplayFor(modelItem => item.ProductName)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.ProductDescription)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.ProductPrice)
        </td>
        <td>
            <img src="@Html.DisplayFor(modelItem => item.ProductImage)"
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.Category.CategoryName)
        </td>
        <td>
            @Html.ActionLink("Sửa", "Edit", new { id=item.ProductID }, new { @class = "btn btn-primary btn-sm " }) |
            @Html.ActionLink("Chi tiết", "Details", new { id=item.ProductID }, new { @class = "btn btn-primary btn-sm " }) |
            @Html.ActionLink("Xóa", "Delete", new { id=item.ProductID }, new { @class = "btn btn-primary btn-sm " })
        </td>
    </tr>
}

</table>
