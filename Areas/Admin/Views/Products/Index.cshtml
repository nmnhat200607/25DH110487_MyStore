@model _25DH110487_MyStore.Models.ViewModels.ProductSearchVM

@{
    ViewBag.Title = "Quản lý sản phẩm";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<h2 class="bg-success text-white p-2">QUẢN LÝ SẢN PHẨM</h2>

<!-- Form tìm kiếm và lọc giá -->
@using (Html.BeginForm("Index", "Products", FormMethod.Get))
{
    <div class="form-group search-container row mb-3">
        <div class="col-md-4">
            @Html.TextBoxFor(m => m.SearchTerm, new { @class = "form-control", placeholder = "Nhập tên, mô tả hoặc chủng loại sản phẩm" })
        </div>
        <div class="col-md-3">
            @Html.TextBoxFor(m => m.MinPrice, new { @class = "form-control", placeholder = "Giá tối thiểu", type = "number" })
        </div>
        <div class="col-md-3">
            @Html.TextBoxFor(m => m.MaxPrice, new { @class = "form-control", placeholder = "Giá tối đa", type = "number" })
        </div>
        <div class="col-md-2">
            <button type="submit" class="btn btn-primary w-100">Tìm kiếm</button>
        </div>
    </div>
}

<!-- Tùy chọn sắp xếp -->
<div class="order-container mb-3">
    <strong>Sắp xếp theo: </strong>
    @Html.ActionLink("Tên tăng dần", "Index", new { sortOrder = "name_asc", searchTerm = Model.SearchTerm, minPrice = Model.MinPrice, maxPrice = Model.MaxPrice }) |
    @Html.ActionLink("Tên giảm dần", "Index", new { sortOrder = "name_desc", searchTerm = Model.SearchTerm, minPrice = Model.MinPrice, maxPrice = Model.MaxPrice }) |
    @Html.ActionLink("Giá tăng dần", "Index", new { sortOrder = "price_asc", searchTerm = Model.SearchTerm, minPrice = Model.MinPrice, maxPrice = Model.MaxPrice }) |
    @Html.ActionLink("Giá giảm dần", "Index", new { sortOrder = "price_desc", searchTerm = Model.SearchTerm, minPrice = Model.MinPrice, maxPrice = Model.MaxPrice })
</div>

<!-- Nhúng Partial View để hiển thị bảng danh sách sản phẩm và phân trang -->
@Html.Partial("PVListProduct", Model)