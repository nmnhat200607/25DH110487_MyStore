@model _25DH110487_MyStore.Models.ViewModels.Cart

@{
    ViewBag.Title = "Giỏ hàng";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .shoppingcart {
        background-color: ghostwhite;
        padding: 15px;
        border-radius: 8px;
    }

    .cart-section {
        background-color: white;
        border: 1px groove #ffffff;
        border-radius: 10px;
        padding: 15px;
        margin-bottom: 15px;
    }

    .cart-button {
        width: 220px;
        border: 1px solid #808080;
        margin: 10px 0;
    }

    .shoppingcart tr {
        font-size: smaller;
    }
</style>

<script language="JavaScript">
    function cartUpdateQuantity(id, newQuantity) {
        if (newQuantity < 1) return;
        const form = document.createElement('form');
        form.method = 'post';
        form.action = '@Url.Action("UpdateQuantity", "Cart")';

        const idInput = document.createElement('input');
        idInput.type = 'hidden'; idInput.name = 'id'; idInput.value = id;
        form.appendChild(idInput);

        const quantityInput = document.createElement('input');
        quantityInput.type = 'hidden'; quantityInput.name = 'quantity'; quantityInput.value = newQuantity;
        form.appendChild(quantityInput);

        document.body.appendChild(form);
        form.submit();
    }
</script>

<h2>GIỎ HÀNG</h2>
<div class="shoppingcart row">
    @if (Model == null || !Model.Items.Any())
    {
        <p>Bạn chưa có sản phẩm nào trong giỏ.</p>
    }
    else
    {
        <div class="col-md-8">
            <div class="cart-section">
                @foreach (var categoryGroup in Model.GroupedItems)
                {
                    <h3>@categoryGroup.Key</h3>
                    <table class="table">
                        <thead>
                            <tr>
                                <th colspan="2">Sản phẩm</th>
                                <th>Số lượng</th>
                                <th>Đơn giá</th>
                                <th>Thành tiền</th>
                                <th title="Xóa tất cả mặt hàng trong giỏ">
                                    <a href="@Url.Action("ClearCart", "Cart", null)">
                                        <i class="fas fa-trash-alt text-danger"></i>
                                    </a>
                                </th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in categoryGroup)
                            {
                                <tr>
                                    <td><img src="@item.ProductImage" alt="@item.ProductName" style="max-height:80px;" /></td>
                                    <td class="col-md-4">@item.ProductName</td>
                                    <td>
                                        @using (Html.BeginForm("UpdateQuantity", "Cart", FormMethod.Post))
                                        {
                                            <input type="hidden" name="id" value="@item.ProductID" />
                                            <button type="button" style="width: 25px;" onclick="cartUpdateQuantity(@item.ProductID, @item.Quantity - 1)">-</button>
                                            <input type="number" name="quantity" value="@item.Quantity" min="1" max="100" style="width: 45px; text-align:right;" readonly />
                                            <button type="button" style="width: 25px;" onclick="cartUpdateQuantity(@item.ProductID, @item.Quantity + 1)">+</button>
                                        }
                                    </td>
                                    <td>@item.UnitPrice.ToString("N0")</td>
                                    <td>@item.TotalPrice.ToString("N0")</td>
                                    <td>
                                        <a href="@Url.Action("RemoveFromCart", "Cart", new { id = item.ProductID })">
                                            <i class="fas fa-trash-alt text-primary"></i>
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        </div>

        <div class="col-md-3 cart-section" style="margin-left: 15px;">
            <div><strong>Tổng giá trị: &nbsp;<span style="color: red;">@Model.TotalValue().ToString("N0")</span></strong></div>
            <div>@Html.ActionLink("Mua hàng", "Checkout", "Order", null, new { @class = "btn btn-danger cart-button" })</div>
        </div>
    }
</div>

<div class="row">
    <div class="col-md-12 cart-section">
        @Html.Partial("_PVSimilarProduct", Model)
    </div>
    <div class="col-md-12">
        @Html.ActionLink("Tiếp tục mua hàng", "Index", "Home", null, new { @class = "btn btn-warning cart-button" })
    </div>
</div>
